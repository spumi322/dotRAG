{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "NotesPath": "../Notes",
  "CachePath": "../cache/embeddings.json",
  "Ingestion": {
    "FileGlob": "*.md"
  },
  "Retrieval": {
    "TopK": 3,
    "MinScore": 0.5
  },
  "Chunking": {
    "MaxChunkChars": 2000,
    "HeadingDepth": 3,
    "MinChunkLength": 20
  },
  "Embedding": {
    "Model": "voyage-3-large"
  },
  "MaxPromptTokens": 8192,
  "OpenRouter": {
    "Model": null
  },
  "ApiKeys": {
    "VoyageApiKey": null,
    "AnthropicApiKey": null,
    "OpenRouterApiKey": null
  }
}
